<!DOCTYPE html>
<html lang="en" xmlns:border="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Temperaturmålere</title>
    <link rel="stylesheet" href="main.css">
    <%if(darkmode == "on"){%>
    <link rel="stylesheet" href="dark.css">
    <%}%>
    <%if(darkmode == "off"){%>
    <link rel="stylesheet" href="light.css">
    <%}%>
<style>
  .dashboard {
    display: flex;
    align-items: center;
    width: 100%;
  }
  .side-col {
    flex: 0 0 auto;
  }
  .controls {
    text-align: center;
  }
  .chart-area {
    flex: 1 1 auto;
    min-width: 0;
    height: 150px;
    position: relative;
  }
  .chart-area canvas {
    display: block;
  }
</style>
</head>
<body>
<div class="dashboard">
    <div class="side-col">
	<div id="sensorHeading" style="font-size:16px;"><%= sensorLabel %><% if (sensorCount > 0) { %> (<%= sensorPosition %>/<%= sensorCount %>)<% } %></div>
	<div id="datoOgTid" style="font-size:16px;">Tidspunkt</div>
	<div id="currentTemp" style="font-size:50px;"> &deg;C</div>
	<div id="humidity" style="font-size:30px;">&#37;</div>
	<div id="max" style="font-size:20px;">Max: &deg;C</div>
	<div id="min" style="font-size:20px;">Min: &deg;C</div>
    </div>
    <div class="chart-area">
	    <canvas id="tempChart"></canvas>
    </div>
    <div class="side-col controls">
        <form action="/sensor/prev" method="get">
            <button type="submit" class="icon-button" aria-label="Previous sensor" title="Previous sensor">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M14.5 5.5 L8 12 L14.5 18.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        </form>
        <form action="/sensor/next" method="get">
            <button type="submit" class="icon-button" aria-label="Next sensor" title="Next sensor">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M9.5 5.5 L16 12 L9.5 18.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        </form>
        <%if(darkmode == "on"){%>
            <form action="/mode/daymode" method="get">
                <button type="submit" class="icon-button" aria-label="Light mode" title="Light mode">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="3.5" fill="none" stroke="currentColor" stroke-width="2"/>
                        <path d="M12 3.5v2.2M12 18.3v2.2M3.5 12h2.2M18.3 12h2.2M6 6l1.6 1.6M16.4 16.4L18 18M18 6l-1.6 1.6M7.6 16.4L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                </button>
            </form>
        <%}%>
        <%if(darkmode == "off"){%>
            <form action="/mode/1" method="get">
                <button type="submit" class="icon-button" aria-label="Dark mode" title="Dark mode">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M16.5 14.5A6.5 6.5 0 0 1 9.2 4.2 6.8 6.8 0 1 0 16.5 14.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    </svg>
                </button>
            </form>
        <%}%>
        <form action="/mode/reload" method="get">
            <button type="submit" class="icon-button" aria-label="Reload page" title="Reload page">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M19.5 12a7.5 7.5 0 1 1-2.2-5.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <path d="M19.5 4.5V9H15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        </form>
    </div>
</div>
<div style="font-size:25px;">
</div>
<div id="json"></div>

<!--script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.8.0/Chart.js"></script-->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>

  const ctxtemp = document.getElementById('tempChart');

  var charting = new Chart(ctxtemp, {
    type: 'line',
    data: {
      labels: ['Red', 'Blue', 'Yellow', 'Green', 'Purple', 'Orange'],
      datasets: [{
			label: 'Temperatur',
		        <%if(darkmode == "on"){%>
			borderColor: 'white',
			<%}%>
		        <%if(darkmode == "off"){%>
			borderColor: 'black',
			<%}%>
        data: [12, 19, 3, 5, 2, 3],
        borderWidth: 3
      }]
    },
	options:{
		responsive: true,
		maintainAspectRatio: false,
		pointRadius: 0,
		<%if(darkmode == "on"){%>
		scales: {
			x: {
				ticks:{
					color: 'white'
				}
			},
			y: {
				grid:{
					color: 'white',
					borderDash: [5, 15]
				},
				ticks:{
					color: 'white'
				}
			}
		},
		<%}%>
		<%if(darkmode == "off"){%>
		scales: {
			x: {
				ticks:{
					color: 'black'
				}
			},
			y: {
				ticks:{
					color: 'black'
				}
			}
		},
		<%}%>
		plugins:{
			legend: {
				display: false
			}
		}
	}
  });

  var fitQueued = false;
  function fitChart() {
    if (fitQueued) {
      return;
    }
    fitQueued = true;
    requestAnimationFrame(function () {
      fitQueued = false;
      var area = document.querySelector('.chart-area');
      if (!area) {
        return;
      }
      var width = area.clientWidth;
      var height = area.clientHeight;
      if (width < 1 || height < 1) {
        return;
      }
      if (ctxtemp.clientWidth === width && ctxtemp.clientHeight === height) {
        return;
      }
      charting.resize(width, height);
    });
  }
  if (window.ResizeObserver) {
    new ResizeObserver(fitChart).observe(document.querySelector('.chart-area'));
  } else {
    window.addEventListener('resize', fitChart);
  }
  fitChart();

async function load() {
      try {
        const response = await fetch('/temperaturer');
        const data = await response.json();
	var dataverdier = [];
	var labelverdier = [];
	if (!Array.isArray(data) || data.length === 0) {
	  document.getElementById('currentTemp').innerHTML = '--°C';
	  document.getElementById('humidity').innerHTML = '--%';
	  document.getElementById('max').innerHTML = 'Max: --°C';
	  document.getElementById('min').innerHTML = 'Min: --°C';
	  document.getElementById('datoOgTid').innerHTML = 'No readings yet';
	  document.getElementById('json').innerHTML = '';
	  charting.data.labels = [];
	  charting.data.datasets[0].data = [];
	  charting.update();
	  return;
	}
	var maxvalue = data[0].temp;
	var minvalue = data[0].temp;
	for(var t = 0; t < data.length; t++){
	   //alert('Temp: ' + t + ', :' + data[t].temp);
	   if(data[t].temp > maxvalue){
	      maxvalue = data[t].temp;
	   }
	   if(data[t].temp < minvalue){
	      minvalue = data[t].temp;
	   }
           dataverdier[t] = data[t].temp
	   labelverdier[t] = data[t].time
           //document.getElementById('json').innerHTML = `Temperatur: ${data[t].temp}°C Kl:${data[t].time}`;
	}
	var chartcanvas = document.getElementById('tempChart');
	charting.data.labels = labelverdier;
        charting.data.datasets[0].data = dataverdier;
        charting.update();
	var maxDiv = document.getElementById('max');
	var minDiv = document.getElementById('min');
        maxDiv.innerHTML = `Max: ${maxvalue}°C`;
        minDiv.innerHTML = `Min: ${minvalue}°C`;
	document.getElementById('currentTemp').innerHTML = Number(data[data.length - 1].temp).toFixed(1) + "°C";
	var humText = data[data.length - 1].hum;
	document.getElementById('humidity').innerHTML = (humText === null || humText === undefined || humText === "") ? "--%" : humText + "&#37;";
	document.getElementById('datoOgTid').innerHTML =  data[data.length - 1].date + ", " + data[data.length -1].time;
	//alert('Test' + chartcanvas.height);
	//Resetter status hvis vi kommer så langt...
        document.getElementById('json').innerHTML = '';
      } catch (error) {
        document.getElementById('json').innerHTML = 'Error loading data';
      }
}
load();
const updateInterval = setInterval(load, 10000);

</script>
</body>
</html>
